# =============================================
# CAU HINH KET NOI SQL SERVER
# =============================================

# Dia chi server SQL Server (localhost hoac IP)
DB_SERVER=localhost

# Ten database da co san (khong can tao lai)
DB_DATABASE=QLSucKhoeNguoiCaoTuoi

# Tai khoan SQL Server (dung SQL Authentication)
DB_USER=sa

# Mat khau tai khoan SQL Server
DB_PASSWORD=your_password_here

# Cong SQL Server (mac dinh 1433)
DB_PORT=1433

# Ma hoa ket noi (false cho moi truong local)
DB_ENCRYPT=false

# Bo qua kiem tra SSL certificate (true cho local dev)
DB_TRUST_SERVER_CERTIFICATE=true

# =============================================
# CAU HINH JSON WEB TOKEN
# =============================================

# Khoa bi mat de ky va xac thuc JWT (dat chuoi ngau nhien dai)
JWT_SECRET=your_super_secret_key_change_this_in_production

# Thoi gian het han token (7d = 7 ngay, 1h = 1 gio)
JWT_EXPIRES_IN=7d

# =============================================
# DANG NHAP GOOGLE DUNG CHUNG WEB VA MOBILE
# =============================================

# OAuth Client ID loai Web application. Day la audience dung de backend
# xac minh Google ID token; khong dat Client Secret trong Mobile.
GOOGLE_WEB_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Tuy chon: danh sach Web origin duoc phep dung GIS, cach nhau bang dau phay.
# Khi bo trong, dung CORS_ORIGINS va localhost trong development.
# Production can HTTPS; Web va API cung site (hoac reverse proxy /api) de
# cookie HttpOnly SameSite=Lax rang buoc phien Google duoc gui dung.
# Them dung Web origin vao Authorized JavaScript origins trong Google Cloud.
GOOGLE_WEB_ORIGINS=

# =============================================
# GUI EMAIL DAT LAI MAT KHAU (GMAIL)
# =============================================

# Dia chi Gmail dung de gui ma OTP
EMAIL_USER=your_email@gmail.com

# App Password 16 ky tu cua Google (khong dung mat khau Gmail thong thuong)
EMAIL_APP_PASSWORD=your_16_character_app_password

# Ten va dia chi hien thi o phan nguoi gui
EMAIL_FROM=CareSenior <your_email@gmail.com>

# Mat khau dung de tao cac tai khoan demo khi chay seed_users.js.
# Bat buoc tu dat, khong de trong va khong commit gia tri that len Git.
SEED_PASSWORD=

# =============================================
# CAU HINH SERVER
# =============================================

# Cong ma Express se lang nghe (mac dinh 5000)
PORT=5000

# Sau so phut qua gio uong ma chua xac nhan, lieu thuoc chuyen BoLo (mac dinh 60).
MEDICATION_MISSED_AFTER_MINUTES=60

# Development cho phep localhost/127.0.0.1/[::1] o cac cong.
# Production chi cho phep origin chinh xac trong danh sach nay (phan cach dau phay).
# Vi du: https://care.example.com,https://admin.example.com ; khong dung wildcard.
NODE_ENV=development
CORS_ORIGINS=

# Tro ly AI: tu dien khoa trong server/.env, khong commit gia tri that.
# Thieu cau hinh: tro ly theo chuc nang van hoat dong. Khong tu chuyen provider.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
